  <MathExpression Id="MuY FL" DisplayUnit="" DisplayDPS="2" DisplayColorIndex="0" Interpolate="1" EnumerationName="" Script="max(min(smooth('Lat Force FL' [N] / 'Tyre Load FL' [N],0.25),2.5),-2.5)" SampleRate="0" Unit=""/>
